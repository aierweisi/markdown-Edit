{
  "name": "markdown-editor",
  "version": "1.0.0",
  "description": "A desktop Markdown editor built with Electron",
  "main": "main/main.js",
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "copy-vendor": "node scripts/copy-vendor.js",
    "dev": "node scripts/dev-build.js",
    "start": "node scripts/dev-build.js && electron .",
    "minify": "node scripts/minify.js",
    "build": "npm run copy-vendor && npm run minify && electron-builder",
    "build:win": "npm run copy-vendor && npm run minify && electron-builder --win",
    "lint": "eslint main/ src/js/ scripts/ tests/",
    "lint:fix": "eslint --fix main/ src/js/ scripts/ tests/",
    "format": "prettier --check main/ src/js/ scripts/ tests/",
    "format:fix": "prettier --write main/ src/js/ scripts/ tests/",
    "test": "vitest run",
    "check": "npm run lint && npm run test"
  },
  "keywords": [],
  "author": "Markdown Editor Team",
  "license": "MIT",
  "dependencies": {
    "codemirror": "5.65.16",
    "dompurify": "3.2.4",
    "electron-store": "^11.0.2",
    "katex": "0.16.21",
    "marked": "15.0.7",
    "mermaid": "10.9.3"
  },
  "devDependencies": {
    "@highlightjs/cdn-assets": "11.9.0",
    "csso": "^5.0.5",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^8.57.1",
    "prettier": "^3.8.3",
    "terser": "^5.48.0",
    "vitest": "^0.34.0"
  },
  "build": {
    "appId": "com.markdown.editor",
    "productName": "Markdown Editor",
    "copyright": "Copyright © 2026",
    "compression": "maximum",
    "asar": true,
    "afterPack": "scripts/afterPack.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.md"
    ],
    "extraMetadata": {
      "main": "dist/main/main.js"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "icon": "assets/icons/icon.ico"
      }
    ],
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "icon": "assets/icons/icon.icns"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Markdown Editor",
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "language": "2052",
      "include": "scripts/installer.nsh"
    },
    "electronVersion": "33.0.0",
    "electronDist": "node_modules/electron/dist"
  }
}
