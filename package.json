{
  "name": "markdown-editor",
  "version": "1.0.0",
  "description": "A desktop Markdown editor built with Electron",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "minify": "node scripts/minify.js",
    "build": "npm run minify && electron-builder",
    "build:win": "npm run minify && electron-builder --win",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "electron-store": "^11.0.2"
  },
  "devDependencies": {
    "csso": "^5.0.5",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "terser": "^5.48.0",
    "vitest": "^4.1.7"
  },
  "build": {
    "appId": "com.markdown.editor",
    "productName": "Markdown Editor",
    "copyright": "Copyright © 2026",
    "compression": "maximum",
    "asar": true,
    "afterPack": "scripts/afterPack.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "!assets/icons/*.png",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!renderer/vendor/katex/fonts/*.ttf",
      "!renderer/vendor/katex/fonts/*.woff",
      "!renderer/vendor/katex/fonts/*.woff2"
    ],
    "extraMetadata": {
      "main": "main/main.js"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "icon": "assets/icons/icon.ico"
      }
    ],
    "win": {
      "icon": "assets/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "icon": "assets/icons/icon.icns"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Markdown Editor",
      "installerIcon": "assets/icons/icon.ico",
      "uninstallerIcon": "assets/icons/icon.ico",
      "language": "2052",
      "include": "scripts/installer.nsh"
    },
    "electronVersion": "28.0.0",
    "electronDist": "node_modules/electron/dist"
  }
}
