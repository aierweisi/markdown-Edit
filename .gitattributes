# Normalize line endings: text files use LF in the repo and working tree.
* text=auto eol=lf

# Windows-only scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaries — never normalize.
*.png binary
*.ico binary
*.icns binary
*.zip binary
*.exe binary
*.dmg binary
*.pak binary
